{
  "name": "vue-uniapp-template",
  "version": "0.1.0",
  "private": true,
  "description": "Vue 3 + TypeScript + uni-app 跨端单应用模板",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^24.11.0",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "dev": "pnpm dev:mp-weixin",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:h5": "uni -p h5",
    "dev:app": "uni -p app",
    "build": "pnpm build:mp-weixin && pnpm build:h5 && pnpm build:app",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:h5": "uni build -p h5",
    "build:app": "uni build -p app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "@wot-ui/ui": "2.3.2",
    "vue": "3.4.21",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "miniprogram-api-typings": "5.2.3",
    "prettier": "3.9.9",
    "sass": "1.105.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "5.2.8",
    "vitest": "3.2.7",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12",
    "weapp-tailwindcss": "5.5.12"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yaml,yml,html}": [
      "prettier --write"
    ]
  }
}
